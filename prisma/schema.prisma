generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  prompts   Prompt[]
  templates Template[]
}

model Prompt {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  category         String
  originalPrompt   String
  optimizedPrompt  String
  score            Int
  clarity          Int
  specificity      Int
  context          Int
  format           Int
  improvements     String
  variations       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Template {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  content   String
  createdAt DateTime @default(now())
}